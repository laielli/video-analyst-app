{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-analyst/eval/question_bank.schema.json",
  "title": "Codegen eval question bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["bank_version", "prompt_version", "cases"],
  "properties": {
    "bank_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump when cases change; provenance for the report header."
    },
    "prompt_version": {
      "type": ["string", "null"],
      "description": "Provenance hint for the prompt the bank was authored against (16-hex); never gating."
    },
    "_comment": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "clip_id", "shape", "phrasing_class", "distance", "question", "expect"],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Stable slug clip-shape-class-N; the fixture key."
        },
        "clip_id": {
          "type": "string",
          "enum": ["single-goal", "bernabeu-counter"]
        },
        "shape": {
          "type": "string",
          "enum": ["first-goal", "count", "scorer-number", "presence", "none"]
        },
        "phrasing_class": {
          "type": "string",
          "enum": ["canonical", "paraphrase", "out_of_scope", "injection", "degenerate"]
        },
        "distance": {
          "type": "string",
          "enum": ["canonical", "near", "far", "n/a"]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Literal maxLength mirrors server.MAX_QUERY_TEXT_LEN; a static schema cannot import it, so a pytest asserts the two agree (the eval library never imports server)."
        },
        "expect": { "$ref": "#/$defs/expect" },
        "notes": { "type": "string" }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "answer_match"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["grounded", "ungrounded"]
        },
        "answer": {
          "type": ["string", "null"],
          "description": "Ground truth for grounded cases; null for ungrounded."
        },
        "answer_match": {
          "type": "string",
          "enum": ["exact", "ci_contains", "numeric", "any_grounded"]
        }
      }
    }
  }
}

# Keep the build context (and image) lean. The runtime server needs only the Python
# source + committed cache/example JSON; everything below is dev-only or regenerable.
.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.run_cache/
tests/
.env
.env.*
# Do NOT ignore Dockerfile/.dockerignore here: `az acr build` packs this context honoring
# .dockerignore, then looks for the Dockerfile INSIDE the uploaded context — excluding it
# breaks the cloud build ("Unable to find 'Dockerfile'"). Both are tiny + harmless in the image.

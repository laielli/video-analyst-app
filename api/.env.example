# Copy to api/.env and fill in. api/.env is gitignored (.env / .env.* rule).

# --- Azure AI Vision Image Analysis 4.0 (ComputerVision resource) ---
# Used by scripts/ocr_probe.py and the detect/read_text primitives.
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-key>

# --- Azure OpenAI (question -> DSL codegen) ---
# Not needed for the OCR harness; here for the next build step (schema-validated codegen).
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Copy to api/.env and fill in. api/.env is gitignored (.env / .env.* rule).

# --- Azure AI Vision Image Analysis 4.0 (ComputerVision resource) ---
# Used by scripts/ocr_probe.py and the detect/read_text primitives.
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-key>

# --- Azure OpenAI (question -> DSL codegen) ---
# Not needed for the OCR harness; here for the next build step (schema-validated codegen).
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Free-text run cache + shareable permalinks ---
# Content-addressed cache: an identical repeat free-text question is served for free (no billed
# codegen call) and its run_id is a stable shareable permalink. Runtime-only, gitignored. No TTL
# knob by design — drift after a prompt/schema change is handled by bumping run_cache.CACHE_FORMAT.
# RUN_CACHE_DIR        — where stored run-docs live. Default: api/.run_cache (gitignored).
# RUN_CACHE_MAX_ENTRIES — soft cap; on overflow the oldest-by-write-time entry is evicted (FIFO,
#                         not LRU). Default 1000. The endpoint is unauthenticated, so this bounds
#                         disk growth on the abuse surface.
RUN_CACHE_DIR=api/.run_cache
RUN_CACHE_MAX_ENTRIES=1000

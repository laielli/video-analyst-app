# Copy to api/.env and fill in. api/.env is gitignored (.env / .env.* rule).

# --- Azure AI Vision Image Analysis 4.0 (ComputerVision resource) ---
# Used by scripts/ocr_probe.py and the detect/read_text primitives.
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-key>

# --- Azure OpenAI (question -> DSL codegen) ---
# Not needed for the OCR harness; here for the next build step (schema-validated codegen).
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Run-doc cache (api/run_cache.py FileRunStore) ---
# Content-addressed cache of validated+grounded free-text run-docs: an identical repeat question
# is served for free (no billed codegen call) and gets a stable shareable permalink (run_id ==
# the sha256 cache key). Both knobs are optional; the defaults below apply if unset.
# RUN_CACHE_DIR: where entries persist (gitignored). Default: api/.run_cache
RUN_CACHE_DIR=
# RUN_CACHE_MAX_ENTRIES: soft cap; oldest-by-write-time evicted on put (FIFO, not LRU). No TTL —
# bump CACHE_FORMAT in run_cache.py to invalidate stale entries after a format/prompt change.
RUN_CACHE_MAX_ENTRIES=1000

# Copy to api/.env and fill in. api/.env is gitignored (.env / .env.* rule).

# --- Azure AI Vision Image Analysis 4.0 (ComputerVision resource) ---
# Used by scripts/ocr_probe.py and the detect/read_text primitives.
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-key>

# --- Azure OpenAI (question -> DSL codegen) ---
# Not needed for the OCR harness; here for the next build step (schema-validated codegen).
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Free-text run cache (content-addressed run-docs + shareable permalinks) ---
# An identical free-text question is served from this cache for free (no billed codegen call),
# and its content-addressed id doubles as a stable shareable permalink (GET ...?run=<id>). The
# directory is gitignored (api/.run_cache/) — runtime-only, never committed. There is NO TTL:
# the soft entry cap bounds growth (FIFO evict-oldest), and bumping run_cache.CACHE_FORMAT is
# the kill-switch when the doc/prompt format changes.
RUN_CACHE_DIR=./.run_cache
RUN_CACHE_MAX_ENTRIES=1000

# Copy to api/.env and fill in. api/.env is gitignored (.env / .env.* rule).

# --- Azure AI Vision Image Analysis 4.0 (ComputerVision resource) ---
# Used by scripts/ocr_probe.py and the detect/read_text primitives.
AZURE_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_VISION_KEY=<your-key>

# --- Azure OpenAI (question -> DSL codegen) ---
# Not needed for the OCR harness; here for the next build step (schema-validated codegen).
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Free-text run cache + permalink store ---
# A content-addressed cache of validated+grounded free-text run-docs, keyed on the normalized
# (query_text, clip) pair. An identical repeat question is served from here for FREE (no billed
# codegen call), and the same key is a stable shareable permalink run_id. Runtime-only + gitignored
# (api/.run_cache/), never committed. No TTL — drift is handled by bumping CACHE_FORMAT in
# run_cache.py; abuse is bounded by the entry cap below (evict-oldest-by-write-time on put).
RUN_CACHE_DIR=api/.run_cache          # where cached run-docs live (default: api/.run_cache)
RUN_CACHE_MAX_ENTRIES=1000            # soft cap; oldest entries are evicted past this
